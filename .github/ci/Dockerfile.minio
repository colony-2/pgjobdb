# syntax=docker/dockerfile:1

# Test-only tools built from pinned upstream source in the workflow. Both images
# need writable storage: /data for the server and /root/.mc for the client.
FROM gcr.io/distroless/static-debian13:nonroot@sha256:1c2c046bc09ed40fad370b599a0b1ae7987f55b01e247cf27a7c27cd97e5bbc7 AS base
USER 0:0

FROM base AS minio
COPY --chmod=0555 minio /minio
ENTRYPOINT ["/minio"]

FROM base AS mc
COPY --chmod=0555 mc /mc
ENTRYPOINT ["/mc"]
